{
	"name": "skill-switchboard",
	"version": "0.6.3",
	"description": "An Obsidian control surface for Agent Skills, runtimes, and adapters.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test:scanner": "node scripts/test-scanner.mjs",
		"test:readiness": "node scripts/test-readiness.mjs",
		"test:lifecycle": "node scripts/test-lifecycle.mjs",
		"test:machine-settings": "node scripts/test-machine-settings.mjs",
		"test:build-id": "node scripts/test-build-id.mjs",
		"test:status-queue": "node scripts/test-status-write-queue.mjs",
		"test:native": "node scripts/test-native.mjs",
		"test:packages": "node scripts/test-packages.mjs",
		"test:install-boundaries": "node scripts/test-install-boundaries.mjs",
		"test:install-plan": "node scripts/test-install-plan.mjs",
		"test:adapter": "node scripts/test-adapter-run.mjs",
		"test:automatic": "node scripts/test-automatic.mjs",
		"test:vault-changes": "node scripts/test-vault-change-impact.mjs",
		"test:distribution": "node scripts/test-distribution.mjs",
		"test:ui": "node scripts/test-ui.mjs",
		"test:ui:live": "node scripts/test-ui-live.mjs",
		"validate:release": "node scripts/validate-release.mjs",
		"test:release-validation": "node scripts/test-release-validation.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node scripts/run-tests.mjs",
		"audit:deps": "npm audit --audit-level=moderate",
		"verify": "npm run audit:deps && npm run lint && npm test && npm run build"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.12",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"overrides": {
		"moment": "^2.31.0"
	}
}
